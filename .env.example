# Copy this file to .env and fill in the values. Never commit .env.
# Anthropic API key: https://console.anthropic.com/settings/keys
# Use a key made just for this project (don't reuse the flight bot's keys).
ANTHROPIC_API_KEY=

# Gmail account that sends the lead summaries, plus its 16-character app password (spaces are fine)
# App passwords: https://myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Where lead summaries go (leave blank to send to GMAIL_ADDRESS)
ALERT_TO=

# Optional: send each lead as JSON to Zapier, Make or a CRM (leave blank to turn off).
# Must start with https://. To test for free, run python -m scripts.webhook_receiver and use http://127.0.0.1:5051/
# Treat the address like a password: anyone who has it can send fake leads to it.
LEAD_WEBHOOK_URL=
# Optional: any long random text. Each lead is then signed in an X-Signature-256 header (HMAC-SHA256).
LEAD_WEBHOOK_SECRET=
