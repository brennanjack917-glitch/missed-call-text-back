# Copy this file to .env and fill in the values. Never commit .env.
# Anthropic API key: https://console.anthropic.com/settings/keys
# Use a key made just for this project (don't reuse the flight bot's keys).
ANTHROPIC_API_KEY=

# Gmail account that sends the lead summaries, plus its 16-character app password (spaces are fine)
# App passwords: https://myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Where lead summaries go (leave blank to send to GMAIL_ADDRESS)
ALERT_TO=
